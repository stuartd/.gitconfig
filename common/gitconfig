[user]
	name = stuartd
	email = stuartd@gmail.com

[help]
	autocorrect = prompt

[column]
	ui = auto

[branch]
	sort = -committerdate

[tag]
	sort = version:refname

[init]
	defaultBranch = main

[diff]
	algorithm = histogram
	colorMoved = plain
	mnemonicPrefix = true
	renames = true

[push]
	default = simple
	autoSetupRemote = true
	followTags = true
	useForceIfIncludes = true

[fetch]
	prune = true
	all = true

[commit]
	verbose = true

[rerere]
	enabled = true
	autoUpdate = true

[core]
	excludesFile = ~/.gitignore
	pager = less -FRX

[rebase]
	autoSquash = true
	autoStash = true
	updateRefs = true

[pull]
	rebase = true

[alias]
	list = log --oneline --abbrev-commit --all --graph --decorate -10
	lg = log --all -10 --graph --date=relative --pretty=format:\"%C(auto)%h %ad | %s%d [%an]%C(reset)\"
    hidden = "!git ls-files -v | grep '^S'"
