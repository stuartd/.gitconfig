# Copy selected settings into the machine's global Git config (~/.gitconfig).
# Uncomment only the settings needed on that machine.

# [user]
# 	email = name@company.example
#
# [user]
# 	signingKey = KEY_ID_FROM_YOUR_LOCAL_KEYRING
#
# [commit]
# 	gpgSign = true
#
# Reset the platform helper and delegate GitHub authentication to GitHub CLI.
# This stores no token in the file; `gh auth login` owns the credential.
#
# [credential "https://github.com"]
# 	helper =
# 	helper = !gh auth git-credential
#
# [credential "https://gist.github.com"]
# 	helper =
# 	helper = !gh auth git-credential
#
# Apply a different identity to repositories below a local directory.
# Keep the referenced config outside this checkout too.
#
# [includeIf "gitdir:~/code/work/"]
# 	path = ~/.config/git/work.gitconfig
